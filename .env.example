# ===========================================
# SocialAutoAgent 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# ===========================================

# DeepSeek API 密钥
DEEPSEEK_API_KEY=your_api_key_here

# AI 模型配置 (可选，默认值如下)
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-v4-flash

# 兼容旧配置: 如果仍使用 DashScope/OpenAI 兼容服务，也可以在 Web 控制台中填写对应 Base URL 和模型名。

# 后端服务端口 (可选)
# BACKEND_PORT=8000

# 前端服务端口 (可选)
# FRONTEND_PORT=8501

# ===========================================
# 数据库后端配置
# ===========================================
# 后端类型: sqlite (默认, 零依赖) 或 postgres (高并发)
# DB_BACKEND=postgres

# PostgreSQL 连接配置 (DB_BACKEND=postgres 时生效)
# PG_HOST=127.0.0.1
# PG_PORT=5432
# PG_DB=scout
# PG_USER=scout
# PG_PASSWORD=scout123

# 历史数据保留天数 (自动清理超过此天数的旧表)
# DB_CLEANUP_KEEP_DAYS=30
