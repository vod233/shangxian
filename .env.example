# ===========================================
# SocialAutoAgent 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# ===========================================

# DeepSeek API 密钥
DEEPSEEK_API_KEY=your_api_key_here

# AI 模型配置 (可选，默认值如下)
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-v4-flash

# 兼容旧配置: 如果仍使用 DashScope/OpenAI 兼容服务，也可以在 Web 控制台中填写对应 Base URL 和模型名。

# 后端服务端口 (可选)
# BACKEND_PORT=8000

# 前端服务端口 (可选)
# FRONTEND_PORT=8501

# ===========================================
# 数据库配置（统一使用 PostgreSQL）
# ===========================================
# 项目已统一为 PostgreSQL 后端，不再支持 SQLite。
# 启动前请确保 PostgreSQL 服务已运行（可用 docker-compose up -d 启动）。
# 所有 PG_* 变量均被业务库和账号库共用，写入同一 scout 数据库（Schema 隔离）。

# PostgreSQL 连接配置
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=scout
PG_USER=scout
PG_PASSWORD=必须设置强随机密码，无默认值

# 历史数据保留天数 (自动清理超过此天数的 records_* 表)
# DB_CLEANUP_KEEP_DAYS=30
