# DeepSeek API 配置 (也可以在启动时通过命令行输入)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# 抖音包名
TIKTOK_PACKAGE=com.ss.android.ugc.aweme

# ===========================================
# 数据库后端配置
# ===========================================
# 后端类型: postgres (高并发) 或 sqlite (默认, 零依赖)
DB_BACKEND=postgres

# 账号服务也使用 PostgreSQL
ACCOUNT_DB_BACKEND=postgres

# PostgreSQL 连接配置
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=scout
PG_USER=scout
PG_PASSWORD=scout123

# 历史数据保留天数 (自动清理超过此天数的旧表)
DB_CLEANUP_KEEP_DAYS=30
